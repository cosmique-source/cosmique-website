{
  "$description": "Cosmique design tokens — the single source of truth. Edit values here, then run `node build-tokens.mjs` to regenerate css/tokens.css and swift/Tokens.swift. Structured to map cleanly onto Style Dictionary later (color tokens carry light/dark modes).",

  "color": {
    "paper":  { "light": "#EBE6D7", "dark": "#141312", "comment": "page background" },
    "card":   { "light": "#EFEBDD", "dark": "#1B1A17", "comment": "raised surface" },
    "ink":    { "light": "#26231C", "dark": "#E9E3D4", "comment": "primary text" },
    "muted":  { "light": "#857F6E", "dark": "#8C8677", "comment": "secondary text" },
    "hair":   { "light": "#D6D0BE", "dark": "#302C26", "comment": "hairline borders" },
    "accent": { "light": "#BC4630", "dark": "#D2502F", "comment": "brick red — per-app override point" },
    "sage":   { "light": "#9FA48E", "dark": "#9FA48E", "comment": "secondary accent" },
    "positive": { "light": "#5E7D4F", "dark": "#84A86E", "comment": "income / success" },
    "negative": { "light": "#B23B2C", "dark": "#D2502F", "comment": "expense / error" },
    "warning":  { "light": "#C28A2B", "dark": "#D9A441", "comment": "over budget / caution" },
    "info":     { "light": "#4A6275", "dark": "#7E97A8", "comment": "neutral info" }
  },

  "font": {
    "sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
  },

  "size": {
    "h1": 52,
    "h2": 26,
    "h3": 20,
    "body": 16,
    "small": 13,
    "kicker": 11
  },

  "weight": {
    "regular": 400,
    "medium": 600,
    "bold": 700
  },

  "space": {
    "xs": 8,
    "sm": 14,
    "md": 24,
    "lg": 40,
    "xl": 64,
    "xxl": 96
  },

  "radius": {
    "sm": 2,
    "md": 12,
    "lg": 16
  },

  "tracking": {
    "tight": "-0.02em",
    "label": "0.16em",
    "kicker": "0.24em"
  }
}
