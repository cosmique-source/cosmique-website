---
layout: atomic.njk
title: "Cosmique — Independent software"
---
<div class="wrap">

  <header class="ds-header">
    <a href="{{ '/' | url }}" class="brand">
      <svg width="40" height="40" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="2.5" style="color:var(--color-ink)"/>
        <circle cx="100" cy="100" r="44" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-ink)"/>
        <circle cx="100" cy="100" r="18" style="fill:var(--color-ink)"/>
        <circle cx="100" cy="100" r="3.6" style="fill:var(--color-accent)"/>
      </svg>
      <span class="wordmark">COSMIQUE</span>
    </a>
    <nav class="nav">
      <a href="#apps">Apps</a>
      <a href="#approach">Approach</a>
      <a href="mailto:hello@cosmique.io">Contact</a>
      <button class="theme-toggle">◑&nbsp;Theme</button>
    </nav>
  </header>

  <section class="hero">
    <div class="eyebrow" style="margin-bottom:30px">{{ site.home.eyebrow }}</div>
    <h1 class="h1">{{ site.home.headline }}</h1>
    <p>{{ site.home.intro }}</p>
  </section>

  <section id="apps">
    <div class="applabel"><h2>The apps</h2><span>{{ site.apps | length }} so far</span></div>
    <div class="appgrid">
      {% for app in site.apps %}
      <a href="{{ ('/apps/' + app.slug + '/') | url }}" class="card app">
        <div class="top">
          {% if app.icon %}<img src="{{ ('/assets/' + app.slug + '/' + app.icon) | url }}" alt="{{ app.name }} icon">{% endif %}
          <span class="no">No. {{ '0' ~ loop.index if loop.index < 10 else loop.index }}</span>
        </div>
        <h3>{{ app.name }}</h3>
        <p>{{ app.description }}</p>
        <div class="foot"><span class="plat">{{ app.platform }}</span><span class="go">View <span>→</span></span></div>
      </a>
      {% endfor %}
    </div>
  </section>

  <section id="approach" class="pillars home-pillars">
    {% for p in site.home.principles %}
    <div>
      <h3>{{ p.title }}</h3>
      <p>{{ p.body }}</p>
    </div>
    {% endfor %}
  </section>

  <footer class="ds-footer">
    <span>{{ site.site.title }} — {{ site.site.description }}, since 2024</span>
    <a href="mailto:hello@cosmique.io">hello@cosmique.io</a>
  </footer>

</div>
