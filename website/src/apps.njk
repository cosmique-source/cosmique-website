---
pagination:
  data: appsStandard
  size: 1
  alias: app
permalink: "/apps/{{ app.slug }}/"
layout: cosmique.njk
eleventyComputed:
  pageTitle: "{{ app.name }} — {{ app.description }}"
  pageDescription: "{{ app.description }}"
---

<div class="wrap">

  {% set crumbName = app.name | upper %}
  {% if app.hasSupport %}
  {% set navLinks = [
    { url: "/apps/" + app.slug + "/#features", label: "Features" },
    { url: "/apps/" + app.slug + "/support/", label: "Support" },
    { url: "/apps/" + app.slug + "/privacy/", label: "Privacy" }
  ] %}
  {% else %}
  {% set navLinks = [{ url: "/apps/" + app.slug + "/#features", label: "Features" }] %}
  {% endif %}
  {% include "ds-header.njk" %}

  <!-- Hero -->
  <section class="app-hero">
    {% if app.icon %}
    <img src="{{ ('/assets/' + app.slug + '/' + app.icon) | url }}" alt="{{ app.name }} icon" class="app-icon" width="88" height="88">
    {% endif %}
    <p class="eyebrow">{{ app.platform }}</p>
    <h1 class="h1">{{ app.description }}</h1>
    <p class="lead">{{ app.fullDescription }}</p>
    <div class="app-cta">
      {% if app.link %}
      <a class="btn" href="{{ app.link }}" target="_blank" rel="noopener">View on the App&nbsp;Store</a>
      {% endif %}
      {% if app.hasSupport %}
      <a class="btn-secondary" href="{{ ('/apps/' + app.slug + '/support/') | url }}">Support →</a>
      {% endif %}
    </div>
  </section>

  <!-- Screenshots -->
  {% if app.watchScreenshots %}
  <section class="app-shots">
    <p class="kick">On your wrist</p>
    <div class="gallery">
      {% for screenshot in app.watchScreenshots %}
      <figure class="shot">
        <img src="{{ ('/assets/' + app.slug + '/' + screenshot) | url }}" alt="{{ app.name }} on Apple Watch" loading="lazy">
      </figure>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if app.iphoneScreenshots %}
  <section class="app-shots">
    {% if app.watchScreenshots %}
    <p class="kick">The iPhone companion</p>
    <p class="shots-note">Manage your feeds on iPhone. They sync instantly to your watch.</p>
    {% else %}
    <p class="kick">Screenshots</p>
    {% endif %}
    <div class="gallery">
      {% for screenshot in app.iphoneScreenshots %}
      <figure class="shot">
        <img src="{{ ('/assets/' + app.slug + '/' + screenshot) | url }}" alt="{{ app.name }} on iPhone" loading="lazy">
      </figure>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- Features -->
  <section class="app-features" id="features">
    <p class="kick">Features</p>
    <div class="feature-grid">
      {% for feature in app.features %}
      {% if " — " in feature %}
      {% set parts = feature | split(" — ") %}
      <div class="feature">
        <span class="no">0{{ loop.index }}</span>
        <h3>{{ parts[0] }}</h3>
        <p>{{ parts[1] }}</p>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% for feature in app.features %}
    {% if " — " not in feature %}
    <div class="callout app-features-note">
      <span class="dot"></span>
      <p>{{ feature }}</p>
    </div>
    {% endif %}
    {% endfor %}
  </section>

  {% if app.hasSupport %}
  {% set footerLinks = [
    { url: "/apps/" + app.slug + "/support/", label: "Support" },
    { url: "/apps/" + app.slug + "/privacy/", label: "Privacy" }
  ] %}
  {% else %}
  {% set footerLinks = [] %}
  {% endif %}
  {% include "ds-footer.njk" %}

</div>
