{# Hero motifs for app pages. content.json sets `hero` per app:
   "dial" (Bulletin), "orbit" (Orbit), "waves" (Punkt). Anything else (or unset)
   falls back to the app icon. Brick/ink bits use tokens so they follow the theme;
   app-specific colours (Bulletin green, vinyl black) are intentional constants. #}

{% macro heroMotif(app, iconUrl) %}
{%- if app.hero == "dial" -%}
  <svg viewBox="0 0 400 400" role="img" aria-label="{{ app.name }} tuner dial">
    <defs>
      <linearGradient id="dialGreen" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#A8BB86"/><stop offset="1" stop-color="#6E8B4F"/>
      </linearGradient>
      <linearGradient id="dialKnob" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFFFFF"/><stop offset="0.35" stop-color="#F2EEE3"/><stop offset="1" stop-color="#C9C3B5"/>
      </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="172" fill="none" stroke="#2C2A24" stroke-width="12"/>
    <circle cx="200" cy="200" r="166" fill="url(#dialGreen)"/>
    <circle cx="200" cy="200" r="140" fill="none" stroke="rgba(28,26,20,.45)" stroke-width="6" stroke-dasharray="2 22"/>
    <g font-family="ui-monospace,Menlo,monospace" font-size="13" fill="rgba(28,26,20,.55)" text-anchor="middle">
      <text x="200" y="94">88</text><text x="312" y="206">96</text><text x="200" y="318">104</text><text x="88" y="206">112</text>
    </g>
    <circle cx="200" cy="40" r="7" fill="var(--color-accent)"/>
    <circle cx="200" cy="200" r="86" fill="url(#dialKnob)" stroke="#B5AFA1" stroke-width="3"/>
    <circle cx="200" cy="200" r="80" fill="none" stroke="#E5E0D4" stroke-width="1.5" stroke-dasharray="9 6"/>
    <line x1="200" y1="126" x2="200" y2="158" stroke="#2C2A24" stroke-width="5" stroke-linecap="round"/>
    <circle cx="200" cy="200" r="26" fill="#2C2A24"/>
    <circle cx="200" cy="200" r="9" fill="var(--color-accent)"/>
  </svg>
{%- elif app.hero == "orbit" -%}
  <svg viewBox="0 0 400 400" role="img" aria-label="{{ app.name }} orbital record">
    <ellipse cx="200" cy="200" rx="195" ry="92" fill="none" stroke="var(--color-ink)" stroke-width="1" opacity=".3"/>
    <ellipse cx="200" cy="200" rx="92" ry="195" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity=".5"/>
    <ellipse cx="200" cy="200" rx="160" ry="160" fill="none" stroke="var(--color-ink)" stroke-width="1" opacity=".3"/>
    <circle cx="200" cy="200" r="64" fill="#26231C"/>
    <circle cx="200" cy="200" r="56" fill="none" stroke="#EBE6D7" stroke-width="1"/>
    <circle cx="200" cy="200" r="48" fill="none" stroke="#EBE6D7" stroke-width="1"/>
    <circle cx="200" cy="200" r="40" fill="none" stroke="#EBE6D7" stroke-width="1"/>
    <circle cx="200" cy="200" r="22" fill="var(--color-accent)"/>
    <circle cx="200" cy="200" r="4" fill="#EBE6D7"/>
  </svg>
{%- elif app.hero == "waves" -%}
  <svg viewBox="0 0 400 400" role="img" aria-label="{{ app.name }} broadcast">
    <g fill="none">
      <circle cx="200" cy="200" r="40" stroke="var(--color-ink)" stroke-width="1.4" opacity=".28"/>
      <circle cx="200" cy="200" r="80" stroke="var(--color-ink)" stroke-width="1.3" opacity=".28"/>
      <circle cx="200" cy="200" r="120" stroke="var(--color-accent)" stroke-width="1.6" opacity=".55"/>
      <circle cx="200" cy="200" r="160" stroke="var(--color-ink)" stroke-width="1.1" opacity=".28"/>
      <circle cx="200" cy="200" r="196" stroke="var(--color-ink)" stroke-width="1" opacity=".22"/>
    </g>
    <circle cx="200" cy="200" r="16" fill="var(--color-ink)"/>
    <circle cx="200" cy="200" r="5" fill="var(--color-accent)"/>
    <circle cx="332" cy="120" r="8" fill="var(--color-accent)"/>
  </svg>
{%- else -%}
  {% if iconUrl %}<img src="{{ iconUrl }}" alt="">{% endif %}
{%- endif -%}
{% endmacro %}
